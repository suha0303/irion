{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "drone.raw.watermark/2.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "clock_id": {
      "type": "string",
      "minLength": 1
    },
    "through_available_time_us": {
      "type": "integer",
      "minimum": 0
    },
    "recorded_events": {
      "type": "integer",
      "minimum": 0
    },
    "closed": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "run_id",
    "clock_id",
    "through_available_time_us",
    "recorded_events",
    "closed"
  ]
}
